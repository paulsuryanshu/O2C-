# =====================================================
# O2C Graph Explorer — Environment Variables
# =====================================================
# Copy this file to backend/.env and fill in values.

# --- LLM Configuration ---
# Choose one provider. If neither is set, falls back to rule-based planning.

# Option A: Google Gemini (free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyC2PKT0kvwInJjB7tlRv58cRdTRlBO56t8

# Option B: Groq (free tier, very fast)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Which provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini

# --- Database ---
# Path to SQLite database file (relative to backend/)
DB_PATH=./o2c.db

# --- Data Directory ---
# Path to folder containing SAP JSON subfolders
DATA_DIR=./data
